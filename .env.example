# BakeMate Environment Configuration Example

#
# HUONG DAN CAU HINH HOSTING
# 1. Sao chep file nay thanh .env tren server.
# 2. Khong dua file .env hoac mat khau that len GitHub.
# 3. Khi deploy production, cau hinh:
#    APP_ENV=production
#    APP_DEBUG=false
#    APP_URL=https://ten-mien-cua-ban
# 4. Dien DB_HOST, DB_NAME, DB_USER, DB_PASS theo hosting.
# 5. Dien thong tin email/API key trong .env neu su dung.
# 6. Bao dam server chan truy cap truc tiep vao .env.
#

APP_NAME=BakeMate
APP_ENV=local
APP_DEBUG=true
APP_URL=
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_bakemate
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_LAN_HOST=

# SMTP Email (PHPMailer / Mailer fallback)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=support@bakemate.vn
MAIL_FROM_NAME=BakeMate

# Payment & Banking (VietQR + Casso Webhook)
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=BAKEMATE STORE
CASSO_API_KEY=
CASSO_WEBHOOK_SECRET=

# Security & Webservices (Optional / Fallback ready)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GHN_API_TOKEN=
GHN_SHOP_ID=
